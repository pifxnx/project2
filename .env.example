DB_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/project2
DB_URL_SYNC=postgresql+psycopg://postgres:postgres@localhost:5432/project2
TOKEN_SECRET=change-me-access-secret-at-least-32-bytes
REFRESH_SECRET=change-me-refresh-secret-at-least-32-bytes
TOKEN_ALGORITHM=HS256
# Время жизни access-токена в секундах, refresh-токена в днях
TOKEN_EXP=900
REFRESH_EXP=7
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
REDIS_URL=redis://localhost:6379/0
UPLOAD_DIR=/tmp/uploads
